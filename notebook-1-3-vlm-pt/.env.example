# Credentials for Lab 3.
#
# Copy this file to `.env` in the same folder and fill in the values, or export
# the variables in your shell. The notebook reads the environment first and
# falls back to `.env`, so an exported value always wins.
#
#     cp .env.example .env
#
# `.env` holds secrets: do not commit it.

# nvcr.io API key. Needed only to pull the TAO container. Not required when the
# image is already present on the instance.
# Get one at https://ngc.nvidia.com  ->  Setup  ->  Generate API Key
NGC_KEY=

# HuggingFace token. Needed only to download Cosmos3-Nano when the converted
# checkpoint is not already staged (section 2.5).
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
